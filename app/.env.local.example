# NutriVibe AI 环境变量模板
# 复制为 .env.local 后填写。只在服务端读取,切勿提交 .env.local,切勿暴露到前端。
# 全部留空 = 演示模式(内置 mock 菜谱)。

# [推荐] Groq API key(免费层):https://console.groq.com/keys
GROQ_API_KEY=
# (可选)Groq 模型,默认 openai/gpt-oss-120b
GROQ_MODEL=
# (可选)gpt-oss 系列推理强度:low | medium | high,默认 medium
GROQ_REASONING_EFFORT=

# [可选] Gemini API key(作为备用提供方)
GEMINI_API_KEY=
# (可选)Gemini 模型,默认 gemini-3.8-flash
GEMINI_MODEL=

# (可选)强制指定提供方:groq | gemini | mock;留空则自动选择
LLM_PROVIDER=

# 사진 식재료 인식(선택). OpenAI 호환 chat/completions 주소·키·모델.
# 비워 두면 GROQ_API_KEY로 Groq 비전 모델을 쓰고, 키가 없으면 데모 목록을 반환합니다.
VISION_API_BASE=
VISION_API_KEY=
VISION_MODEL=