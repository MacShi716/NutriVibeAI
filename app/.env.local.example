# NutriVibe AI 환경 변수 템플릿
# 복사하여 .env.local 로 저장한 뒤 채웁니다.
# .env.local 은 gitignore 되어 있으며 커밋하지 마십시오.
# 공개 사이트(github.io)에는 키를 넣지 않습니다. 키는 중계 서버 또는 Vercel 콘솔에만 둡니다.

# 브라우저가 호출하는 전용 중계 URL. 키를 넣지 마십시오.
# 예: https://nutrivibeai-zhipu-relay-<suffix>.cn-hongkong.fcapp.run
# 비워 두면 GitHub Pages 는 내장 레시피 데모로 동작하고,
# 로컬/Vercel 서버 빌드는 아래 서버 전용 키를 사용합니다.
NEXT_PUBLIC_RELAY_URL=

# 서버 전용(API Route / 중계). NEXT_PUBLIC_ 또는 VITE_ 이름에 넣지 마십시오.
# 로컬 `npm run dev` 또는 Vercel 백업에서만 사용합니다.
ZHIPU_API_KEY=

# (선택) zhipu | mock . 비우면 키가 있을 때 zhipu, 없으면 데모.
LLM_PROVIDER=
